# Copy this file to .env and fill in values. .env is gitignored; never commit secrets.
# AI explanation works WITHOUT a key: AI_PROVIDER=none uses the deterministic
# fallback. Set AI_PROVIDER=groq plus GROQ_API_KEY to enable live AI output.
AI_PROVIDER=none
AI_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=1
